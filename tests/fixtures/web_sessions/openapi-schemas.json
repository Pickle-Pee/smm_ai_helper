      "UserRef": {
        "x-status": "proposed",
        "x-persistence": "computed-per-viewer",
        "description": "Minimal reference to a user inside a tenant, COMPUTED for the current caller on every response.\nNever persisted, never hashed, never part of an immutable record: persisted records store only the\nstable `users.id` (for example `SnapshotProvenance.author_user_id`). `display_name` is the user's\nCURRENT name and `is_self` is `id == principal.user_id`, so two viewers of the same record can receive\ndifferent `is_self` values (see fixture `golden/snapshot-two-viewers.json`). Never contains a Telegram\nidentifier or e-mail.\n",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "is_self"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "Internal `users.id` (the single principal for web and Telegram)."
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255,
            "description": "Current display name at response time; may change."
          },
          "is_self": {
            "type": "boolean",
            "description": "True when this user is the caller of THIS request. Viewer-relative."
          }
        }
      },
      "ProjectBrand": {
        "x-status": "proposed",
        "description": "The single `project_brands` row of a project (exactly one per project, cascade-deleted with it).\nA separate table: the legacy `brand_profiles` table, its `UNIQUE(user_id)` and\n`User.brand_profile` keep their current ORM semantics and are used by Telegram only.\n",
